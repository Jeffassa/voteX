# Database (Supabase Postgres direct connection ou Postgres local)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase (optionnel — utilisé par le frontend pour Realtime)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# JWT — OBLIGATOIRE en prod, min 32 caractères aléatoires
# Génère avec : openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies d'auth
# En prod : COOKIE_SECURE=true (HTTPS obligatoire)
# En dev sur localhost : COOKIE_SECURE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Blockchain (optionnel — best-effort)
WEB3_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x...
ADMIN_PRIVATE_KEY=0x...

# Email transactionnel (optionnel — Mailtrap pour dev / SMTP réel pour prod)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@esatic-smartvote.ci
MAIL_PORT=587
MAIL_SERVER=
MAIL_FROM_NAME=ESATIC SmartVote

# CORS — première URL = frontend principal. Origines additionnelles séparées par virgules.
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=

# Rate limiting (slowapi syntax)
RATE_LIMIT_VOTE=5/minute
RATE_LIMIT_LOGIN=10/minute
