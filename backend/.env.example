# ============================================================================
# ESATIC SmartVote — Variables d'environnement
# ============================================================================
# Copiez ce fichier en .env et remplissez chaque variable.
# ⚠️  Ne committez JAMAIS le fichier .env dans Git.
# Générez les secrets avec : openssl rand -hex 32
# ============================================================================

# ── Environnement ────────────────────────────────────────────────────────────
# development | staging | production
# En production, le backend refuse de démarrer si JWT_SECRET est un secret de
# démonstration publié dans le dépôt, si COOKIE_SECURE=false, ou si la base
# est un fichier SQLite.
ENVIRONMENT=development

# ── Base de données ──────────────────────────────────────────────────────────
# Rôle applicatif (moindre privilège — SELECT, INSERT, UPDATE, DELETE uniquement)
# Exécutez scripts/setup_db_role.sql pour créer le rôle smartvote_app.
DATABASE_URL=postgresql://smartvote_app:CHANGE_ME@localhost:5432/smartvote_db

# ── Supabase (optionnel — pour le Realtime frontend) ─────────────────────────
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── JWT & Authentification ───────────────────────────────────────────────────
# OBLIGATOIRE — Minimum 32 caractères aléatoires
# Générez avec : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookies de session ───────────────────────────────────────────────────────
# Production  : COOKIE_SECURE=true  (HTTPS obligatoire)
# Développement : COOKIE_SECURE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ── Blockchain (optionnel — best-effort) ─────────────────────────────────────
# Laissez vide pour désactiver. Le hash sera enregistré uniquement off-chain.
WEB3_RPC_URL=
CONTRACT_ADDRESS=
# ⚠️  En production, stockez la clé privée dans un Secrets Manager (GCP/AWS).
# Ne la mettez JAMAIS en clair dans ce fichier en production.
ADMIN_PRIVATE_KEY=

# ── Email transactionnel (Resend) ────────────────────────────────────────────
# Créez un compte sur https://resend.com et obtenez votre clé API.
RESEND_API_KEY=re_...
RESEND_DOMAIN_FROM=no-reply@votre-domaine.ci

# ── Email SMTP alternatif (Mailtrap pour dev) ────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@esatic-smartvote.ci
MAIL_PORT=587
MAIL_SERVER=
MAIL_FROM_NAME=ESATIC SmartVote

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL du frontend React. Origines additionnelles séparées par virgules.
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_VOTE=5/minute
RATE_LIMIT_LOGIN=10/minute

# ── Cache Redis (optionnel) ──────────────────────────────────────────────────
# Laissez vide pour désactiver le cache (mode passthrough sans erreur).
# En production : redis://:[MOT_DE_PASSE]@redis-host:6379/0
REDIS_URL=
# Durée de vie du cache des résultats d'élections fermées (en secondes)
CACHE_TTL_SECONDS=300

# ── Métriques Prometheus (optionnel) ─────────────────────────────────────────
# /metrics décrit toute la surface de l'API et le rythme des votes : il reste
# fermé tant que METRICS_ENABLED n'est pas explicitement activé.
# Si METRICS_TOKEN est défini, le scraper doit présenter « Authorization:
# Bearer <token> » (Prometheus : authorization.credentials).
METRICS_ENABLED=false
METRICS_TOKEN=

# ── Monitoring Sentry (optionnel) ────────────────────────────────────────────
# Créez un projet sur https://sentry.io pour obtenir votre DSN.
SENTRY_DSN=
