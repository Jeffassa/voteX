# URL de l'API, service distinct du frontend. Obligatoire pour un build de
# production : sans elle, `npm run build` échoue plutôt que de publier un site
# qui appellerait localhost.
VITE_API_URL=http://localhost:8000

# URL publique du frontend : URL canoniques, image de partage, robots.txt et
# sitemap.xml. Défaut : https://smartvote.esatic.ci
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Override de l'explorateur blockchain (par défaut Sepolia Etherscan)
# Pour Mainnet : https://etherscan.io
# Pour Polygon : https://polygonscan.com
VITE_CHAIN_EXPLORER_BASE=https://sepolia.etherscan.io
