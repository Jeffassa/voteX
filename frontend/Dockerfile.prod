# ─── Étape 1 : Build ───
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# L'API est un service séparé, sur sa propre origine. Son URL est figée dans le
# bundle au build, qui échoue si elle manque (voir vite.config.ts) :
#   docker build -f Dockerfile.prod \
#     --build-arg VITE_API_URL=https://api.smartvote.esatic.ci \
#     --build-arg VITE_SITE_URL=https://smartvote.esatic.ci .
ARG VITE_API_URL
ARG VITE_SITE_URL
ARG VITE_CHAIN_EXPLORER_BASE=https://sepolia.etherscan.io
ENV VITE_API_URL=$VITE_API_URL \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_CHAIN_EXPLORER_BASE=$VITE_CHAIN_EXPLORER_BASE

COPY . .
RUN npm run build

# ─── Étape 2 : Serveur de production Nginx ───
FROM nginx:1.27-alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

# Origine de l'API, injectée dans la CSP au démarrage du conteneur.
# À surcharger : docker run -e API_ORIGIN="https://api.smartvote.esatic.ci"
ENV API_ORIGIN="http://localhost:8000"

# nginx:alpine passe /etc/nginx/templates/*.template dans envsubst au
# démarrage (vers conf.d/), ce qui injecte API_ORIGIN sans rebuild.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/default.conf.template nginx/security-headers.inc.template /etc/nginx/templates/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
