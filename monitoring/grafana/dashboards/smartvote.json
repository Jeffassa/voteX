{
  "uid": "smartvote-scrutin",
  "title": "SmartVote — Scrutin & API",
  "tags": ["esatic", "smartvote"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilité de l'API",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "HORS LIGNE", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "EN LIGNE", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"backend\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bulletins déposés (1 h)",
      "description": "Nombre de POST /api/votes/ ayant abouti. Ne dit rien du contenu des bulletins.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(increase(smartvote_http_requests_total{handler=\"/api/votes/\",status=~\"2..\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bulletins refusés en erreur serveur (1 h)",
      "description": "Doit rester à zéro pendant un scrutin ouvert. Toute valeur non nulle signifie des votes perdus.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(increase(smartvote_http_requests_total{handler=\"/api/votes/\",status=~\"5..\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Connexions refusées (1 h)",
      "description": "Un pic sans campagne de communication en cours évoque une attaque par essais successifs.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(increase(smartvote_http_requests_total{handler=\"/api/auth/login\",status=~\"4..\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requêtes par seconde, par code de réponse",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (status) (rate(smartvote_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latence des routes (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(smartvote_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connexions PostgreSQL actives",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "legendFormat": "connexions", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Mémoire et disque de l'hôte",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "mémoire utilisée",
          "refId": "A"
        },
        {
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)",
          "legendFormat": "disque utilisé",
          "refId": "B"
        }
      ]
    }
  ]
}
